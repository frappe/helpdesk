		{
			"fieldname": "ai_provider",
			"fieldtype": "Select",
			"label": "Provider",
			"options": "Anthropic\nAnthropic Compatible\nOpenAI Compatible",
			"default": "Anthropic",
			"description": "Anthropic Compatible: Kimi/Moonshot, GLM/Zhipu \u2014 same API shape, set Base URL. OpenAI Compatible: Poolside, Qwen \u2014 triage only; investigation sessions need Anthropic or Anthropic Compatible."
		},
		{
			"fieldname": "ai_base_url",
			"fieldtype": "Data",
			"label": "Base URL",
			"depends_on": "eval:doc.ai_provider && doc.ai_provider != 'Anthropic'",
			"description": "e.g. https://api.moonshot.ai/anthropic or https://inference.poolside.ai/v1"
		},
		{
			"fieldname": "investigation_provider",
			"fieldtype": "Select",
			"label": "Investigation Provider",
			"options": "\nAnthropic\nAnthropic Compatible",
			"description": "Optional override: run investigation sessions on a different provider than triage (e.g. cheap OpenAI-compatible triage + Anthropic investigation). Blank = same as Provider above. OpenAI-Compatible is not offered here \u2014 sessions need Anthropic tool-use."
		},
		{
			"fieldname": "investigation_base_url",
